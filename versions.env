# versions.env —— haoxun-v3 底坯镜像版本钉子(单一权威源,build/verify/stage 皆 source 本件)
# 钉子原则:与现役镜像 16b35bf1669c 内实测逐件相等(2026-10-24 harvest 实录)。

# ── 镜像锚 ──
INCUMBENT_FINGERPRINT="16b35bf1669c"   # 现役(harvest 源与回退锚;Expires 2026-11-20,到期前须再出版)
BASE_IMAGE="634810653f2d"              # 构建底坯:本地缓存 bookworm(serial 20261022_05:24;现役底坯为 20261021,允许差)
ALIAS_VERIFY_DEFAULT="haoxun-v3-verify" # 构建/验证测试别名(绝不出版到保护名单)
PROTECTED_ALIASES="haoxun-v3 hx-agent-base hx-agent-base-v1-bookworm haoxun-v3-app pi-rs-agent-current"

# ── 九件套版本 ──
V_CLAUDE="2.1.296"
V_GROK="1.0.50"
V_CODEX="0.162.1"
V_BROWSE="0.37.2"
V_CHROME="155.0.8059.39"
V_UV="0.13.4"
V_NODE="22.23.3"
V_NPM="10.9.9"
V_PYTHON="3.11.2"                      # bookworm 自带,断言用
# 官方标准 pi(earendil-works/pi;pi-rs 插件线另窗,不入镜像)
V_PI="1.4.0"

# ── web 容器镜像(web/ 配方;与实例段同文件分界)──
WEB_ALIAS_VERIFY="haoxun-web-verify"
WEB_PROTECTED_ALIASES="haoxun-web"
WEB_V_OVIS="30f7783"                    # raystyle/herdr-web-ui 钉 commit(fleet-only+树形侧栏)
WEB_BASE_IMAGE="634810653f2d"           # 同实例底坯 bookworm
INCUS_ADMIN_GID="971"                   # 宿主 incus socket 组(实证)
# staging 源(宿主产出;agent-runtime 不引用父仓工作树,只吃成品)
SRC_PI="/home/ray/staging-hxr/pi-linux-x64.tar.gz"
SRC_ZACP="/home/ray/staging-hxr/zacp"
SRC_HERDR="/home/ray/.local/bin/herdr"

# ── 桌面/acpsup 契约常量 ──
DISPLAY_NUM="99"
ACP_PORT="7663"

# ── 二进制 sha256 台账(与 blobs/MANIFEST.md 同源;stage.sh 逐件核)──
SHA_ACPSUP="93fd6312b2048b33fc1ef7ab567c875b3f7f05cddd945111a82569307432888a"
SHA_UV="5b2a2df4ef04c5d778d50702d6e1d1ff22909fc883086b4ef406a4f115e3c4fb"
SHA_UVX="2044b4dd5a37d593c0d6ab279777dfec833f4d4e81c0aa74b05098f595a849c7"
SHA_BROWSE="9ab30f9da9ba18f25d907efb6e5d3e281dd6b2dad304ae1e9e4d684e9751c6a8"
SHA_CLAUDE="24972e3bc859fab2b46ed4c1e51f7d6130f06d3bd550811a114640de3370d0de"
SHA_GROK="c80de0155706ff2d995623887b102f2d0abd2c62b2643dea3a0cebaf7dd724d5"
SHA_CODEX="628e35487d888a28f0427fc37501da529dd3d81fcbad7a2c3421c1e8670d92e1"
SHA_CHROME_ZIP="97c96584b628ae1ea379e6db1f14bbafc4d72d4a3edb0ee5416860e0ebf23acd"
SHA_PI="f2e4e4329603223d03260cdb8bd5033dbdc1f73ba58ab8939db2e56546e115d2"

# ── 宿主产物路径(staging 来源②;2026-10-24 实测与镜像 sha256 全等)──
SRC_BROWSE="/home/ray/dev-chrome/browse-zigbuild/browse-v${V_BROWSE}-glibc2.17"
SRC_CLAUDE="/home/ray/.local/bin/claude"
SRC_GROK="/home/ray/.local/bin/grok"
SRC_CODEX="/home/ray/.local/share/codex/bin/codex"
# 注意:现役镜像内 clean-chrome 目录名无 gen9-r2 后缀 → 主源=gen8-r4 zip(与镜像逐名相等),gen9-r2 为升级备源
SRC_CHROME_ZIP="/home/ray/dev-chrome/dist-gen8-r4/chromium-${V_CHROME}-x86_64-unknown-linux-gnu.zip"
